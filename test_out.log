                                            <DropdownMenuItem onClick={() => setActiveTab('applications')}>
                                                Applications
                                            </DropdownMenuItem>
                                            <DropdownMenuItem onClick={() => setActiveTab('projects')}>
                                                Project Groups
                                            </DropdownMenuItem>
                                        </DropdownMenuContent>
